{
  "firestore": { "rules": "firestore.rules" },
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/manifest.webmanifest","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/eduvos-logo.png","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/eduvos-logo.svg","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/icon.png","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/icon.svg","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]}
    ]
  }
}
